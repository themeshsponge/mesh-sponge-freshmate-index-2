{% assign sst = section.settings %}
{%- assign xxl = 100 | divided_by: sst.xxl -%}
{%- assign xl = 100 | divided_by: sst.xl -%}
{%- assign lg = 100 | divided_by: sst.lg -%}
{%- assign md = 100 | divided_by: sst.md -%}
{%- assign sm = 100 | divided_by: sst.sm -%}
{%- assign xs = 100 | divided_by: sst.xs -%}
{%- assign collection = collections[sst.collection] -%}
{%- assign product_limit = sst.limit -%}
{%- capture container -%}
  {{- section.settings.container -}}
{%- endcapture -%}
{%- style -%}
  #shopify-section-{{ section.id }}{
    padding-top: {{ section.settings.distance_top | append: 'px' -}};
    padding-bottom: {{ section.settings.distance_bottom | append: 'px' -}};
  }
  @media(max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ sst.distance_top | times: 0.7 | round: 0 }}px;
      padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<div class="{% if sst.class != blank %}{{ sst.class }}{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
   <div class="{{ container }}">
      {% if sst.heading != blank %}
         <div class="title_section {{ sst.title_alignment }}">
            <div class="title" style="color: {{ sst.heading_c }};">{{ sst.heading }}</div>
         </div>
      {% endif %}
      <div class="row">
         <div class="col-12 block-info-product">
            <div class="grid--view-items nov-slick-carousel row spacing-{{ sst.spacing }}"
               data-autoplay="false"
               data-autoplayTimeout="6000"
               data-loop="false"
               data-dots="{{ sst.show_dots }}"
               data-nav="false"
               data-row="{{ sst.row_number }}"
               data-row_mobile="{{ sst.row_mobile }}"
               data-items_xxl="{{ sst.xxl }}"
               data-items="{{ sst.xl }}"
               data-items_lg="{{ sst.lg }}"
               data-items_md="{{ sst.md }}"
               data-items_sm="{{ sst.sm }}"
               data-items_xs="{{ sst.xs }}"
               data-custnav>
               {% for product in collection.products limit: product_limit %}
                  {% if sectionId == blank %}
                     {% assign sectionId = section.id %}
                  {% endif %}
                  <div class="block">
                     <div class="item p_item">
                        {% render 'product-list-items-style', product: product, sectionId: sectionId %}
                     </div>
                  </div>
               {%  else %}
                  {% render 'product_template_list_no_content', product: product, product_limit: product_limit %}
               {% endfor %}
            </div>
         </div>
      </div>
   </div>
</div>

{% schema %}
   {
      "name": "Vinova Product List",
      "class": "section-product-list-slider",
      "settings": [
         {
            "type": "richtext",
            "id": "heading",
            "label": "Heading",
            "default": "<p>New Arrivals</p>"
         },
         {
            "type": "color",
            "id": "heading_c",
            "label": "Heading Color",
            "default": "#222222"
         },
         {
            "type": "select",
            "id": "title_alignment",
            "label": "Heading alignment",
            "default": "text-center",
            "options": [
               {
                  "value": "text-left",
                  "label": "Left"
               },
               {
                  "value": "text-center",
                  "label": "Center"
               },
               {
                  "value": "text-right",
                  "label": "Right"
               }
            ]
         },
         {
            "type":  "header",
            "content": "Block product"
         },
         {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
         },
            {
            "type":  "header",
            "content": "Product item per row"
         },
         {
            "type": "range",
            "id": "xxl",
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Extra desktop",
            "default": 3,
            "info": "Breakpoint 1440px ↑"
         },
         {
            "type": "range",
            "id": "xl",
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Large desktop",
            "default": 3,
            "info": "Breakpoint 1200px ↑"
         },
         {
            "type": "range",
            "id": "lg",
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Desktop",
            "default": 2,
            "info": "Breakpoint 992px ↑"
         },
         {
            "type": "range",
            "id": "md",
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Tablet",
            "default": 2,
            "info": "Breakpoint 768px ↑"
         },
         {
            "type": "range",
            "id": "sm",
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Large mobile",
            "default":1,
            "info": "Breakpoint 576px ↑"
         },
         {
            "type": "range",
            "id": "xs",
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Mobile",
            "default": 1,
            "info": "Breakpoint 575px ↓"
         },
         {
            "type": "range",
            "id": "limit",
            "min": 4,
            "max": 30,
            "step": 1,
            "label": "Limit",
            "default": 12,
            "info": "Select number limit products"
         },
         {
            "type": "range",
            "id": "spacing",
            "min": 0,
            "max": 30,
            "step": 5,
            "unit": "px",
            "label": "Spacing",
            "default": 30,
            "info": "Spacing item"
            },
            {
            "type":  "header",
            "content": "Slider options"
         },
         {
            "type": "range",
            "id": "row_number",
            "min": 1,
            "max": 3,
            "step": 1,
            "label": "Number row",
            "default": 2
            },
         {
            "type": "range",
            "id": "row_mobile",
            "min": 1,
            "max": 3,
            "step": 1,
            "label": "Number row mobile",
            "default": 2
         },
         {
            "type": "checkbox",
            "id": "show_dots",
            "label": "Show dots",
            "default": true
         },
         {
            "type":  "header",
            "content": "Design option"
         },
         {
            "type": "checkbox",
            "id": "animate",
            "label": "Show animated",
            "default": true
         },
         {
            "type": "select",
            "id": "container",
            "label": "Container",
            "default": "container",
            "options": [
               { "value": "container", "label": "Container" },
               { "value": "container-fluid", "label": "Container fluid" },
               { "value": "container-full", "label": "Container full width" }
            ]
         },
         {
            "type": "text",
            "id": "class",
            "label": "Class"
         },
         {
            "type": "number",
            "id": "distance_top",
            "label": "Top spacing section (px)",
            "default": 30
         },
         {
            "type": "number",
            "id": "distance_bottom",
            "label": "Bottom spacing section (px)",
            "default": 30
         }
      ],
      "presets": [
         {
            "name": "Vinova Product List Slider"
         }
      ]
   }
{% endschema %}
