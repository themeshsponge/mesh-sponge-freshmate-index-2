{%- assign sst = section.settings -%}
<div class="{% if sst.bg_size == 'full' %}distance {% endif %}{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}">
  {% if sst.container == 'container' %}
    <div class="container">
  {% elsif sst.container == 'container-fluid' %}
    <div class="container-fluid">
  {% else %}
    <div class="container-full">
  {% endif %}
    <div class="{% if sst.bg_size == 'content' %}distance {% endif %}container-inner">
      {% if sst.icon_newsletter != blank %}
        <div class="title-icon text-center mb-10"><img class="lazyload d-inline-block" data-src="{{ sst.icon_newsletter | img_url: '150x' }}" alt=""></div>
      {% endif %}
      {% if sst.heading != blank or sst.subheading != blank %}
        <div class="title_section {{ sst.title_alignment }}">
          {% if sst.heading != blank %}
            <span class="title" style="color: {{ sst.heading_c }};">{{ sst.heading }}</span>
          {% endif %}
          {% if sst.subheading != blank %}
            <span class="sub_title" style="color: {{ sst.subheading_c }};">{{ sst.subheading }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% form 'customer', id: 'section-contact' %}
        {{ form.errors | default_errors }}
        {% if form.posted_successfully? %}
        <p class="form--success text-center">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {% else %}
        <div class="input-group">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email"
          name="contact[email]"
          class="input-group__field newsletter__input form-control"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}">
          <button type="submit" class="newsletter__submit btn btn-xmedium" name="commit" title="{{ 'general.newsletter_form.submit' | t }}">
            {{ 'general.newsletter_form.submit' | t }}
          </button>
        </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Newsletter",
    "class": "section-newsletter",
    "settings": [
      {
        "type": "paragraph",
        "content": "Any customers who sign up will have an account created for them in Shopify. [View customers](/admin/customers?query=&accepts_marketing=1)"
      },
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Newsletter</p>"
      },
      {
        "type": "color",
        "id": "heading_c",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_c",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "image_picker",
        "id": "icon_newsletter",
        "label": "Icon newsletter",
        "info": "50 x 50px recommended"
      },
      {
        "type": "select",
        "id": "title_alignment",
        "label": "Heading alignment",
        "default": "text-center",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type":  "header",
        "content": "Style newsletter"
      },
      {
        "type": "color",
        "id": "input_c",
        "label": "Input color",
        "default":   "#666"
      },
      {
        "type": "color",
        "id": "input_bg",
        "label": "Input background",
        "default":   "#fff"
      },
      {
        "type": "color",
        "id": "input_bd",
        "label": "Input border color",
        "default":   "#fff"
      },
      {
        "type": "color",
        "id": "btn_c",
        "label": "Button color",
        "default":   "#fff"
      },
      {
        "type": "color",
        "id": "btn_bg",
        "label": "Button background",
        "default":   "#444"
      },
      {
        "type": "color",
        "id": "btn_bgh",
        "label": "Button background hover",
        "default":   "#000"
      },
      {
        "type":  "header",
        "content": "Design option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "color_background",
        "id": "gradient",
        "label": "Background gradient",
        "default": "linear-gradient(180deg, rgba(242, 242, 242, 1), rgba(242, 242, 242, 1) 100%)"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "select",
        "id": "bg_size",
        "label": "Background size",
        "default": "full",
        "options": [
          { "value": "content", "label": "Container" },
          { "value": "full", "label": "Full width" }
        ]
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "number",
        "id": "distance_top",
        "label": "Top spacing section (px)",
        "default": 30
      },
      {
        "type": "number",
        "id": "distance_bottom",
        "label": "Bottom spacing section (px)",
        "default": 30
      }
    ],
    "presets": [{
      "name": "Vinova Newsletter",
      "category": "Promotional"
    }]
  }
{% endschema %}
{%- assign bg_image = sst.background_image -%}
<style>
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top | append: 'px' }};
    padding-bottom: {{ sst.distance_bottom | append: 'px' }};
    transform: translateZ(0);
    overflow: hidden;
    {%- if sst.gradient != blank -%}background: {{ sst.gradient }};{%- endif -%}
    {%- if bg_image.src != blank -%}background-image: url("{{ bg_image | img_url: '1920x' }}");background-position: center;background-repeat: no-repeat;background-size: cover;{%- endif -%}
  }
  @media(max-width: 991px) {
    #shopify-section-{{ section.id }} .distance {
      {%- if sst.distance_top > 20 -%}padding-top: {{ sst.distance_top | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
      {%- if sst.distance_bottom > 20 -%}padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
    }
  }
  #shopify-section-{{ section.id }}  .errors {
    color: {{ sst.subheading_c }};
  }
  #shopify-section-{{ section.id }} input {
    color: {{ sst.input_c }};
    background-color: {{ sst.input_bg }};
    border-color: {{ sst.input_bd }};
  }
  #shopify-section-{{ section.id }} button {
    color: {{ sst.btn_c }};
    background-color: {{ sst.btn_bg }};
  }
  #shopify-section-{{ section.id }} button:hover {
    background-color: {{ sst.btn_bgh }};
  }
</style>
