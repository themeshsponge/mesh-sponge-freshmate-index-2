<style>
  #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
    width: {{ xs }}%;
    flex: 0 0 {{ xs }}%;
  }
  @media(min-width:  576px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ sm }}%;
      flex: 0 0 {{ sm }}%;
    }
  }
  @media(min-width:  768px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ md }}%;
      flex: 0 0 {{ md }}%;
    }
  }
  @media(min-width:  992px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ lg }}%;
      flex: 0 0 {{ lg }}%;
    }
  }
  @media(min-width:  1200px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ xl }}%;
      flex: 0 0 {{ xl }}%;
    }
  }
  @media(min-width:  1440px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ xxl }}%;
      flex: 0 0 {{ xxl }}%;
    }
  }
  #shopify-section-{{ section.id }} .slick-list {
    margin: -15px;
    padding: 15px;
  }
  {%- assign bg_image = sst.background_image -%}
  {% if sst.bg_size == 'full' %}
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top | append: 'px' }};
      padding-bottom: {{ sst.distance_bottom | append: 'px' }};
      border-radius: {{ sst.br_container | append: 'px' }};
      {% if sst.background_color != blank or bg_image != blank %}
        background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '1920x' }}"){% endif %} no-repeat center;
        background-size: cover;
      {% endif %}
    }
    @media(max-width: 767px) {
      #shopify-section-{{ section.id }} .distance {
        {%- if sst.distance_top > 20 -%}padding-top: {{ sst.distance_top | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
        {%- if sst.distance_bottom > 20 -%}padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
      }
    }
  {% else %}
    #shopify-section-{{ section.id }} .container-inner {
      padding-top: {{ sst.distance_top | append: 'px' }};
      padding-bottom: {{ sst.distance_bottom | append: 'px' }};
      border-radius: {{ sst.br_container | append: 'px' }};
      {% if sst.background_color != blank or bg_image.src != blank %}
        background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '1920x' }}"){% endif %} no-repeat center;
        background-size: cover;
      {% endif %}
    }
    @media(max-width: 767px) {
      #shopify-section-{{ section.id }} .container-inner {
        {%- if sst.distance_top > 20 -%}padding-top: {{ sst.distance_top | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
        {%- if sst.distance_bottom > 20 -%}padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
      }
    }
  {% endif %}
  #shopify-section-{{ section.id }} .title_section{
    margin-bottom: 5.2rem;
  }
  #shopify-section-{{ section.id }} .title_section .title{
    text-transform: uppercase;
  }
  {% if sst.show_border -%}
    #shopify-section-{{ section.id }} .collec-image:after {
      border-radius: {% if sst.border_radius_round %}9999999px{% else %}{{ sst.border_radius }}px{% endif %};
      border: 1px {{ sst.style_border }} {{ sst.c_border }};
    }
  {%- endif -%}
  #shopify-section-{{ section.id }} .block-image {
    border-radius: {% if sst.border_radius_round %}9999999px{% else %}{{ sst.border_radius }}px{% endif %};
    transform: translateZ(0);
    {% if sst.show_bg_img -%}
      background-color: {{ sst.bg_img }};
    {%- endif -%}
  }
  {% if sst.icon_hover != blank %}
    #shopify-section-{{ section.id }} .block-image:after {
      border-radius: {% if sst.border_radius_round %}9999999px{% else %}{{ sst.border_radius }}px{% endif %};
    }
  {% endif %}
  #shopify-section-{{ section.id }} img {
    border-radius: {% if sst.border_radius_round %}9999999px{% else %}{{ sst.border_radius }}px{% endif %};
  }
  #shopify-section-{{ section.id }} .collec-img__text, #shopify-section-{{ section.id }} .collec-img__text a {
    font-size: {{ sst.t_s | divided_by: 10.0 | append: 'rem' }};
    color:  {{ sst.t_c }};
  }
  #shopify-section-{{ section.id }} .collec-img__desc {
    font-size: {{ sst.st_s | divided_by: 10.0 | append: 'rem' }};
    color:  {{ sst.st_c }};
  }
  #shopify-section-{{ section.id }} .btn {
    color: {{ sst.c_btn }};
    background-color: {{ sst.b_btn }};
  }
  #shopify-section-{{ section.id }} .btn:hover {
    color: {{ sst.c_btn_h }} !important;
    background-color: {{ sst.b_btn_h }} !important;
  }
  {% if sst.show_box_shadow %}
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .block-image {
        box-shadow: 11px 11px 0 5px {{ block.settings.box_shadow_color }};
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .block-image:before {
        border-radius: {% if sst.border_radius_round %}9999999px{% else %}{{ sst.border_radius }}px{% endif %};
      }
    {% endfor %}
  {% endif %}
  {% unless sst.show_box_shadow %}
    #shopify-section-{{ section.id }} .block-image {
      position: relative;
      z-index: 2;
    }
  {% endunless %}
  {% if sst.mw %}
    #shopify-section-{{ section.id }} .item {
      max-width: {{ sst.mw_item }}px;
      margin:  auto;
    }
  {% endif %}
</style>
