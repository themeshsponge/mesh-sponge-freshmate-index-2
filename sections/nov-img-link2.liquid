{% assign sst = section.settings %}
{%- assign xxl = 100 | divided_by: sst.xxl -%}
{%- assign xl = 100 | divided_by: sst.xl -%}
{%- assign lg = 100 | divided_by: sst.lg -%}
{%- assign md = 100 | divided_by: sst.md -%}
{%- assign sm = 100 | divided_by: sst.sm -%}
{%- assign xs = 100 | divided_by: sst.xs -%}
{%- capture container -%}
  {{- sst.container -}}
{%- endcapture -%}
<div class="distance overflow_hidden{% if sst.class_section != blank %} {{ sst.class_section }}{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div  class="{{ container }}">
    <div class="container-inner position-relative">
      {% if sst.heading != blank or sst.subheading != blank %}
        <div class="title_section {{ sst.title_alignment }}">
          {% if sst.heading != blank %}
            <span class="title" style="color: {{ sst.heading_c }};">{{ sst.heading }}</span>
          {% endif %}
          {% if sst.subheading != blank %}
            <span class="sub_title" style="color: {{ sst.subheading_c }};">{{ sst.subheading }}</span>
          {% endif %}
        </div>
      {% endif %}
      <div class="nov-slick-carousel row spacing-30{% if sst.show_dot %} pb-40{% endif %}{% if sst.show_border %} show-border{% endif %}{% if sst.show_box_shadow %} show-box-shadow{% endif %}{% if sst.icon_hover != blank %} has-icon-hover{% endif %}{% if sst.animate_hover %} animate-hover{% endif %}"
        data-autoplay="false"
        data-loop="false"
        data-nav="false"
        data-dots="{{ sst.show_dot }}"
        data-items_xxl="{{ sst.xxl }}"
        data-items="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.xs }}"
        data-row="{{ sst.row_number }}"
        data-row_mobile="{{ sst.row_mobile }}">
        {% for block in section.blocks %}
        {% assign bst = block.settings %}
        <div class="block p_item">
          <div>
            <div class="item block-{{ forloop.index }}{% if bst.class != blank %} {{ bst.class }}{% endif %}">
              <div class="collec-img__item">
                <div class="collec-image">
                  <div class="block-image {% if sst.img_animate %}nov-sh-image-2{% endif %}">
                    {% if sst.icon_hover != blank %}
                      <img data-src="{{ sst.icon_hover | img_url: '50x' }}" class="icon-hover lazyload" alt="{{ sst.icon_hover.alt }}">
                    {% endif %}
                    <a href="{{ bst.link }}">
                      {% if bst.image != blank %}
                        {% assign img_url = bst.image %}
                        <div class="respone_image" style="padding-top: 100%">
                            {%- liquid
                              assign image_height = bst.image.width | divided_by: bst.image.aspect_ratio
                              assign widths = '375, 550, 750, 1100, 1500, 1780, 2048'
                            -%}
                          {{ bst.image | image_url: width: 2048 | image_tag:
                            loading: 'lazy',
                            width: bst.image.width,
                            height: image_height,
                            class: "image-fluid",
                            widths: widths
                          }}
                        </div>
                      {% else %}
                        {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                        {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </a>
                  </div>
                </div>
                <div class="collec-img__content {{ sst.block_alignment }}">
                  {% if bst.cta_label != blank %}
                    <div class="collec-img__text font-700 mt-25">
                      <a href="{{ bst.link }}" class="hover:c_df">{{ bst.cta_label }}</a>
                    </div>
                  {% endif %}
                  {% if bst.desc != blank %}
                    <div class="collec-img__desc mt-10">{{ bst.desc }}</div>
                  {% endif %}
                  {% if bst.btn != blank %}
                    <a href="{{ bst.link }}" class="btn mt-15">{{ bst.btn }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div><!-- End container -->
</div>
{% if section.blocks.size == 0 %}
  {% include 'no-blocks' %}
{% endif %}

